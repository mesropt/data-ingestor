# The mapper reads ANTHROPIC_API_KEY from the environment. Export it before
# running, e.g.  export ANTHROPIC_API_KEY=sk-ant-...  (or `set -a; . ./.env`).
# Use your personal Anthropic org key (UUID 474eb356-d20a-4417-997d-0c59c21e897a),
# not an employer key.
ANTHROPIC_API_KEY=

# --- Auth (Phase 06) ---
# Signs session cookies and email-verification tokens. MUST be set or the app
# fails loud (RuntimeError) at first sign-in. Generate a value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Google OAuth is off by default (D-06-05). Set to 1 to enable the flagged path.
DATA_INGESTOR_GOOGLE_OAUTH=0
# Placeholders for the flagged-off Google path; wire real values later (out of scope).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL (dev defaults -- non-secret, match docker-compose.yml).
# The `+psycopg` is MANDATORY: a bare `postgresql://` prefix resolves to psycopg2.
DATABASE_URL=postgresql+psycopg://assayingest:assayingest@localhost:5432/assayingest
# The suite runs against a SEPARATE database, never the dev one.
DATABASE_URL_TEST=postgresql+psycopg://assayingest:assayingest@localhost:5432/assayingest_test
